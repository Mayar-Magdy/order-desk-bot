# Copy this file to .env and change the values for any real deployment.
# Docker Compose reads .env automatically. Without it, development defaults are used.

# PostgreSQL superuser. Used only to create the two roles below, the first time
# the database starts.
POSTGRES_PASSWORD=change-me

# Owner role: owns the tables and runs migrations.
ORDERDESK_OWNER_PASSWORD=change-me

# Application role: the only role the running app uses. It is not a superuser,
# owns nothing and cannot bypass row-level security.
ORDERDESK_APP_PASSWORD=change-me

# Databases to create. Add orderdesk_test if you run the test suite locally.
ORDERDESK_DATABASES=orderdesk

# Ports published on this machine.
ORDERDESK_DB_PORT=5432
ORDERDESK_API_PORT=8000
